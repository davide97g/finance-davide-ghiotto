# Copy to .env before `docker compose up`. Dokploy takes the same keys as
# environment variables on the application.

POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# openssl rand -hex 32
SESSION_SECRET=change-me

# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=https://finance.home.lan

# false when reaching the stack over plain http on the LAN
SECURE_COOKIES=true

# Host port nginx is published on
WEB_PORT=8080
