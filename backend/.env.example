# Postgres connection used by the API and by drizzle-kit
DATABASE_URL=postgres://finance:finance@localhost:5432/finance

# Secret signing the session JWT. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Comma separated list of origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:8080

# Port the API listens on
PORT=3000

# Set to true behind HTTPS so the session cookie gets the Secure flag
SECURE_COOKIES=false
